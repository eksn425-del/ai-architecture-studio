diff --git a/ruby_plugin/su_mcp_bridge/ops/spec_store.rb b/ruby_plugin/su_mcp_bridge/ops/spec_store.rb
new file mode 100644
index 0000000..bec6f71
--- /dev/null
+++ b/ruby_plugin/su_mcp_bridge/ops/spec_store.rb
@@ -0,0 +1,19 @@
+require 'json'
+
+module SUMCPBridge
+  module Ops
+    module SpecStore
+      def self.read(value, kind)
+        parsed = value.is_a?(String) ? JSON.parse(value) : value
+        valid = kind == :array ? parsed.is_a?(Array) : parsed.is_a?(Hash)
+        valid ? parsed : (kind == :array ? [] : nil)
+      rescue JSON::ParserError, TypeError
+        kind == :array ? [] : nil
+      end
+
+      def self.write(value)
+        JSON.generate(value)
+      end
+    end
+  end
+end
