    "hard_constraints": [
      "保持两层白色矩形体量及平屋顶轮廓。",
      "正面保留一层宽幅玻璃开口、二层两组玻璃开口、外挑阳台和透明栏杆。",
      "正面右端保留跨两层的竖向木格栅带。",
      "后立面保留每层三扇竖向窄窗的可见排列。",
      "入口位于侧面并保留小雨棚及台阶。",
      "平屋面在连续女儿墙内侧下沉，保留可见的铺装分格。",
      "上述外观按整图重建为同一栋建筑，不以通用体块替代。"
    ],
    "assumptions": [
      "整体宽约10500 mm、进深约8500 mm、地坪至女儿墙顶约6850 mm，均为比例估算。",
      "正面以阳台立面为准；面对正面时木格栅在右端，入口位于右侧面。",
      "因透视面板对侧面窗洞有遮挡，R1C3与R2C1暂映射为后立面与右侧面，保留交接处的对应关系。",
      "室内只补足维持合理 circulation 的楼梯、客餐厅等必要关系；仅把图中透过玻璃可见的家具外观视为源证据。",
      "周边树木、草地和天空不纳入建筑模型；近建筑铺地仅作为底部环境表达。"
    ],
    "inference_policy": {
      "unseen_exterior": "infer_coherent",
      "unseen_interior": "infer_plausible",
      "preserve_circulation": true
    }
