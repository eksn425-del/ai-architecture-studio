  "quality_status": "needs_fix",
  "needs_fix": true,
  "assessment": "源图1展示正面和右前斜视；源图2展示屋顶俯视、左侧露台近景和左端立面；源图3展示楼梯与上层玻璃近景、穿孔屏正面。共同地标为左侧两层露台、沿正面下降的两跑楼梯、中央木色墙、右侧转角穿孔屏及屋顶玻璃亭。可见源图还包括厚白色露台边板、玻璃栏杆、沿底层布置的实体花池和露台座椅遮阳伞。当前主要体量关系及穿孔屏转角已形成，但白色构件厚度、上层窗分格和底层花池仍有明显缺失或偏差。源图没有确认尺寸；背面及隐藏内部不能据此判错。截图也不足以验证楼梯与平台、屏框与楼板的实际接合，不能将投影重叠认定为可靠连接。",
  "issues": [
    {
      "priority": 1,
      "view": "unspecified",
      "problem": "源图露台边缘和楼梯外侧均呈连续、厚实的白色板带；当前露台白色边板过薄，楼梯侧板近似窄斜梁，踏步锯齿明显改变了源图的实体侧面轮廓。",
      "action": "局部加深露台白色边板和两跑楼梯外侧白板，保持现有踏步与中间平台位置；使白板沿坡段、平台连续接合，并核实梯脚落地及梯顶接平台。"
    },
    {
      "priority": 2,
      "view": "unspecified",
      "problem": "源图楼梯后方上层玻璃窗有明确的下部横向分格；当前对应正面玻璃主要只有竖框，缺少这条横框，窗的开口比例与源图不同。",
      "action": "仅在源图可见的对应窗组补齐下部横框，使横框与竖框真实连接、玻璃分片吻合；不要将室内透出的线条视作已完成窗框。"
    },
    {
      "priority": 3,
      "view": "unspecified",
      "problem": "源图底层长玻璃前及右侧转角有连续凸起花池，左侧露台下也有花池；当前这些位置均为裸露平板，缺少源图明确可见的基座轮廓和玻璃前退让关系。",
      "action": "沿源图可见范围局部补建花池实体边框，保留入口和楼梯落脚通道；先恢复花池高度、宽度及转角连接，再考虑植物细节。"
    }
  ],
  "keep": [
    "右侧穿孔屏沿正面转至右侧的布置关系。",
    "中央木色实墙位于左侧玻璃窗与右侧屏幕之间的关系。",
